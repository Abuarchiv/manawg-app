{
	"name": "manawg-app",
	"private": true,
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": "22.x",
		"pnpm": "9.x"
	},
	"pnpm": {
		"overrides": {
			"postcss@8.4.31": "8.5.26",
			"brace-expansion@^5.0.8": "5.0.12"
		}
	},
	"scripts": {
		"dev": "pnpm --filter @manawg/web dev",
		"build": "pnpm --filter @manawg/web build",
		"test": "pnpm -r run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r --if-present run typecheck",
		"clean": "rm -rf apps/web/.next node_modules/.cache",
		"e2e": "pnpm --filter @manawg/web test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0"
	}
}
