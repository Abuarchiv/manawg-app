# ============================================================
# apps/web — Environment Variables
# ============================================================
# Stack: Next.js + Supabase Auth and Storage (eu-central).
#
# PUBLIC keys (NEXT_PUBLIC_*): embedded in the client bundle.
# SERVER-ONLY keys: API routes only.
#
# Copy this file to apps/web/.env.local and fill in the values.
# ============================================================

# === App ====================================================
# Public app URL — used for invite links, mail links, OG images, robots, sitemap.
NEXT_PUBLIC_APP_URL=https://wg.example.com
# Site with this instance's /impressum, /datenschutz and /agb (legal links in the
# app and in mails). Unset: no legal links are shown, except on the official instance, which
# falls back to https://manawg.com. Self-hosted instances set their own.
NEXT_PUBLIC_LEGAL_URL=https://example.com
# Address behind "Fehler per E-Mail melden". Unset: the report links are hidden, except on the
# official instance, which uses info@manawg.com.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# "false" hides the Google buttons (instances without a Google OAuth client). Unset: shown.
GOOGLE_SIGN_IN=

# === Anonymous product analytics (optional) =================
# Public PostHog project token. Leave empty to keep analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error and structured error-log reporting. DSN is a public project key.
NEXT_PUBLIC_SENTRY_DSN=
# Optional labels on every event. Environment defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
# Optional source-map upload at build time; keep these server-only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === Supabase Auth ==========================================
# Public values read by the Next.js server (session cookies, OAuth callback).
# Format: https://<project-ref>.supabase.co and sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# === Database ===============================================
# POSTGRES_URL is the Supavisor Transaction Pooler connection (port 6543).
# DATABASE_URL is the supported alias (db/index.ts falls back to it).
# Format: postgres://user:pass@host:port/dbname?sslmode=require
# The runtime URLs may point at a local PostgreSQL (port 5432) for development.
POSTGRES_URL=
DATABASE_URL=
# Supabase session connection on port 5432: either the session pooler
# (*.pooler.supabase.com, IPv4) or db.<ref>.supabase.co (IPv6 only).
# `pnpm --filter @manawg/web db:migrate` rejects port 6543 and does not read .env files,
# so export this variable in the shell. Other PostgreSQL servers need MANAWG_SELF_HOSTED=true
# and the anon and authenticated roles.
DATABASE_MIGRATION_URL=
# Migration tooling fallback only (db-migrate, drizzle-kit); the app runtime never reads them.
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=

# === Migration mode =========================================
# Set to true during the database migration window to block all writes.
# /api/wg, /api/cron/* and all mutation endpoints return 503.
# /api/wg/<code> GET and /api/health remain available.
MIGRATION_READ_ONLY=false

# === Image uploads (Supabase Storage) =========================
# Private bucket for receipt and announcement images: 8 MiB limit and exactly the MIME types
# in src/core/infra/private-image-policy.ts. The service-role key is server-only and must
# never use a NEXT_PUBLIC_ name; account deletion needs it too.
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# === Rate limiting (Upstash) ================================
# Required on Vercel production: without it the API routes answer 503 rate_limiter_unavailable.
# Optional locally (unthrottled in development) and in Docker (counted in memory per process).
# Response replay is Postgres-backed either way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Chat message limits (optional) ==========================
# Page sizes for GET /api/wg/<code>/chat/messages; the message length is fixed at 4000.
# Invalid or out-of-range values clamp back to these defaults.
CHAT_MESSAGES_PAGE_DEFAULT=50
CHAT_MESSAGES_PAGE_MAX=100

# === List limits (optional) ==================================
# Caps for GET /api/wg/<code>/inventory and /shopping.
# Same clamping rules as the chat limits; hard ceiling 5000.
INVENTORY_LIST_LIMIT=1000
SHOPPING_ITEMS_LIST_LIMIT=1000

# === Notifications: Web Push ================================
# Generate VAPID keys with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact of the operator as a mailto: or https: URL. Push needs it in production.
VAPID_SUBJECT=

# === Cron =====================================================
# Required in production: /api/cron/* routes fail-closed (503) without it.
# Optional for local dev.
CRON_SECRET=

# === E-mail (SMTP or Resend) =================================
# Covers every mail the app sends itself: monthly statement
# (/api/cron/monthly-statements), welcome, invitation, reminder and
# account-deleted mails. Auth mails (confirm, code, reset) go through Supabase.
# When SMTP_HOST is set, the app sends over SMTP on any host.
# SMTP_HOST=
# 587 by default; 465 uses implicit TLS.
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Resend is used when SMTP_HOST is unset. With Resend, mails only leave the process on
# VERCEL_ENV=production (or with an allow-list); otherwise a dry run is logged.
RESEND_API_KEY=
# Sender for all mails. Required on self-hosted instances and must be an address the mail
# provider accepts; only the official instance falls back to "ManaWG <noreply@manawg.com>".
STATEMENT_EMAIL_FROM=
# Optional, comma-separated: only these addresses are mailed, also in Preview.
STATEMENT_EMAIL_ALLOWLIST=

# === Signing secret ==========================================
# REQUIRED. Signs calendar feed URLs and statement unsubscribe links. Normal API
# access relies on the Supabase session only.
# Generate with:
#   openssl rand -hex 32
# To rotate: put the new value in MEMBER_SESSION_SECRET and move the old one to
# MEMBER_SESSION_SECRET_PREVIOUS (comma-separated), so existing calendar feed URLs
# and statement unsubscribe links keep working. Remove the old value
# once feeds were re-subscribed.
MEMBER_SESSION_SECRET=
MEMBER_SESSION_SECRET_PREVIOUS=

# === Build tooling (optional, local only) ====================
# ANALYZE=true enables the Next bundle analyzer for `pnpm build`.
ANALYZE=
