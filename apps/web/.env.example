# ============================================================
# apps/web — Environment Variables
# ============================================================
# Stack: Next.js + Supabase Auth (eu-central) + S3 image uploads.
#
# PUBLIC keys (NEXT_PUBLIC_*): embedded in the client bundle.
# SERVER-ONLY keys: API routes only.
#
# After provisioning Supabase + S3, pull with:
#   vercel env pull apps/web/.env.local
# ============================================================

# === App ====================================================
# Public app URL — used for invite links, OG images, robots, sitemap.
NEXT_PUBLIC_APP_URL=https://manawg.com

# === Anonymous product analytics (optional) =================
# Public PostHog project token. Without it, analytics stays disabled.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error and structured error-log reporting. DSN is a public project key.
NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload at build time; keep these server-only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === Supabase Auth ==========================================
# Public values used by the browser client and OAuth callback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# === QA / release E2E (optional) ==============================
# These values belong to disposable QA accounts and protected Preview CI.
# Do not use production credentials here.
E2E_SUPABASE_URL=
E2E_SUPABASE_PUBLISHABLE_KEY=
E2E_SUPABASE_TEST_EMAIL=
E2E_SUPABASE_TEST_PASSWORD=
SUPABASE_AUTH_TEST_EMAIL=
SUPABASE_AUTH_TEST_PASSWORD=
SUPABASE_AUTH_TEST_MEMBER_WG_CODE=
SUPABASE_AUTH_TEST_MEMBER_NAME=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Local and CI test switches; leave false unless the matching test is selected.
BASE_URL=http://localhost:3101
E2E_PORT=3101
E2E_FIXTURE_MODE=false
NEXT_PUBLIC_E2E_FIXTURE_MODE=false
NEXT_PUBLIC_DB_DOWN=false
PREVIEW_E2E=false
REAL_PRODUCT_E2E=false
PUBLIC_ENTRY_E2E=false
AUTH_LIVE_E2E=false
SUPABASE_AUTH_LIVE_E2E=false
SUPABASE_AUTH_PASSWORD_RESET_SMOKE=false

# === Database ===============================================
# POSTGRES_URL is the Supavisor Transaction Pooler connection (port 6543).
# DATABASE_URL is the supported alias (db/index.ts falls back to it).
# DATABASE_MIGRATION_URL is the Supabase Direct or Session Pooler connection (port 5432).
# Used for Drizzle DDL/migrations and transactions requiring session semantics. Must not use port 6543.
# For local development, omit the port or use port 5432.
POSTGRES_URL=postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
DATABASE_MIGRATION_URL=postgres://user:pass@host:5432/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=

# === Migration mode =========================================
# Set to true during the database migration window to block all writes.
# /api/wg, /api/cron/* and all mutation endpoints return 503.
# /api/wg/<code> GET and /api/health remain available.
MIGRATION_READ_ONLY=false

# === S3 / Uploads ===========================================
# AWS S3 is the default image provider (avatars, chat attachments).
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are server-only secrets.
# S3_PUBLIC_URL is the read-only CDN/origin URL prefix and is also
# enforced by the image-URL validator on the server.
IMAGE_STORAGE_PROVIDER=aws
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Set IMAGE_STORAGE_PROVIDER=supabase for the private Preview bucket.
# The service-role key is server-only and must never use a NEXT_PUBLIC_ name.
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# === Rate limiting (Upstash) — optional ======================
# When unset, rate-limit fails open (dev-friendly, unthrottled).
# Response-replay idempotency is Postgres-backed regardless of this —
# it does not depend on Upstash being configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Chat message limits (optional) ==========================
# Server-side caps for POST/GET /api/wg/<code>/chat/messages.
# Invalid or out-of-range values clamp back to these defaults.
CHAT_MESSAGES_BODY_MAX=4000
CHAT_MESSAGES_PAGE_DEFAULT=50
CHAT_MESSAGES_PAGE_MAX=100

# === List limits (optional) ==================================
# Caps for GET /api/wg/<code>/inventory and /shopping.
# Same clamping rules as the chat limits; hard ceiling 5000.
INVENTORY_LIST_LIMIT=1000
SHOPPING_ITEMS_LIST_LIMIT=1000

# === Notifications: Web Push ================================
# Generate VAPID keys with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@manawg.com

# === Cron =====================================================
# Required in production: /api/cron/* routes fail-closed (503) without it.
# Optional for local dev.
CRON_SECRET=

# === Member sessions =========================================
# REQUIRED in production. Signs the per-member session token
# (HMAC-SHA256) that proves a request's x-manawg-member-id header is not
# spoofed. Gates admin-only WG mutations (delete WG, rename, rotate share
# code, toggle joining) — without it those endpoints reject every request
# with 403 rather than falling back to unsigned auth. Generate with:
#   openssl rand -hex 32
MEMBER_SESSION_SECRET=

# === PayPal settlements =====================================
# Sandbox first; switch to live only after PayPal marketplace/merchant setup.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Required for marketplace payments to a WG member's Merchant ID.
PAYPAL_PARTNER_ATTRIBUTION_ID=
NEXT_PUBLIC_PAYPAL_PARTNER_ATTRIBUTION_ID=
# Your approved PayPal platform partner account's Merchant ID (not a WG member).
# Enables hosted PayPal account connection; no member types an ID into ManaWG.
PAYPAL_PARTNER_MERCHANT_ID=
# NEXT_PUBLIC_APP_URL above supplies the trusted onboarding return origin.
# Live use requires PayPal partner approval and a Platform REST app.

# === PWA / Mobile (native deep-links) =======================
# Required for the iOS / Android well-known association files
# served by app/.well-known/apple-app-site-association/route.ts
# and app/.well-known/assetlinks.json/route.ts.
# When unset, the routes return empty associations (safe default).
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# === Build tooling (optional, local only) ====================
# ANALYZE=true enables the Next bundle analyzer for `pnpm build`.
ANALYZE=
